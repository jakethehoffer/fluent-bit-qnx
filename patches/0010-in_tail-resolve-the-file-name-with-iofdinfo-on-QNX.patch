From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jake Hoffman <122403457+jakethehoffer@users.noreply.github.com>
Date: Thu, 12 Nov 2026 12:10:00 -0500
Subject: [PATCH] in_tail: resolve the file name with iofdinfo on QNX

flb_tail_file_name() finds the path of an open file by following the symlink
/proc/<pid>/fd/<fd> on Linux. QNX has no such symlink. The documented way to
turn an open file descriptor back into a path is iofdinfo() from
<sys/iomgr.h>; with _FDINFO_FLAG_LOCALPATH it returns the path as the local
filesystem sees it.

Add a QNX branch that calls iofdinfo(), fails on an error or a truncated
path, and terminates the result with '\0'.

Signed-off-by: Jake Hoffman <122403457+jakethehoffer@users.noreply.github.com>
---
 plugins/in_tail/tail_file.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/plugins/in_tail/tail_file.c b/plugins/in_tail/tail_file.c
index 44e667f..77ca5be 100644
--- a/plugins/in_tail/tail_file.c
+++ b/plugins/in_tail/tail_file.c
@@ -32,6 +32,9 @@
 #include <fluent-bit/flb_compat.h>
 #include <fluent-bit/flb_info.h>
 #include <fluent-bit/flb_input_plugin.h>
+#ifdef __QNXNTO__
+#include <sys/iomgr.h>
+#endif
 #include <fluent-bit/flb_parser.h>
 #ifdef FLB_HAVE_REGEX
 #include <fluent-bit/flb_regex.h>
@@ -2343,6 +2346,8 @@ char *flb_tail_file_name(struct flb_tail_file *file)
     char path[PATH_MAX];
 #elif defined(FLB_SYSTEM_WINDOWS)
     HANDLE h;
+#elif defined(__QNXNTO__)
+    int len;
 #elif defined(FLB_SYSTEM_FREEBSD)
     struct kinfo_file *file_entries;
     int file_count;
@@ -2435,6 +2440,19 @@ char *flb_tail_file_name(struct flb_tail_file *file)
             memmove(buf, buf + 4, len + 1);
         }
     }
+#elif defined(__QNXNTO__)
+    /* QNX has no /proc/<pid>/fd: ask the resource manager for the path */
+    len = iofdinfo(file->fd, _FDINFO_FLAG_LOCALPATH, NULL, buf, PATH_MAX);
+    if (len == -1) {
+        flb_errno();
+        flb_free(buf);
+        return NULL;
+    }
+    if (len >= PATH_MAX) {
+        flb_free(buf);
+        return NULL;
+    }
+    buf[len] = '\0';
 #elif defined(FLB_SYSTEM_FREEBSD)
     if ((file_entries = kinfo_getfile(getpid(), &file_count)) == NULL) {
         flb_free(buf);
